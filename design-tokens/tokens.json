{
  "$description": "Smile Club 'Day & Night' design tokens. Single source for web (src/styles/theme.css), Android (Compose) and iOS (SwiftUI). Keep the three in sync when changing a value.",
  "font": {
    "latin": "Nunito",
    "devanagari": "Baloo 2",
    "weights": { "regular": 700, "bold": 800, "black": 900 },
    "scale": { "display": 32, "title": 28, "headline": 20, "body": 17, "label": 15, "caption": 13 }
  },
  "radius": { "card": 24, "tile": 28, "button": 22, "pill": 999 },
  "space": { "xs": 4, "s": 8, "m": 12, "l": 16, "xl": 20, "xxl": 24 },
  "touchTarget": { "min": 48, "child": 64 },
  "brand": {
    "mint": "#3DD6B5", "mintEdge": "#1F9E83", "onMint": "#10142E",
    "gold": "#FFCB45", "coral": "#FF8A6B", "lilac": "#A99BFF"
  },
  "themes": {
    "night": {
      "skyTop": "#252A6E", "sky": "#1B1E4B", "ground": "#15183F", "groundLine": "#2C3170",
      "surface": "#262A63", "surfaceSoft": "rgba(255,255,255,0.06)", "chip": "rgba(255,255,255,0.08)",
      "ink": "#FFFFFF", "ink2": "#D3D5F2", "ink3": "#A3A7DA",
      "tile": "#2A2E6E", "tileEdge": "#12153A", "tileSelected": "#2F5E66"
    },
    "day": {
      "skyTop": "#FFE7B3", "sky": "#FFF4DC", "ground": "#D7F3EA", "groundLine": "#B9E8D9",
      "surface": "#FFFFFF", "surfaceSoft": "#FFFFFF", "chip": "rgba(255,255,255,0.7)",
      "ink": "#1B1E4B", "ink2": "#4A4E72", "ink3": "#5D6185",
      "tile": "#FFFFFF", "tileEdge": "#EADCC0", "tileSelected": "#E8FBF5"
    }
  },
  "dayHours": { "start": 5, "end": 17 }
}
